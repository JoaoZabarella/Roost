# ─────────────────────────────────────────────────────────────
# Roost environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# All values below are placeholders, not real secrets.
# ─────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_DB=roost
POSTGRES_USER=roost
POSTGRES_PASSWORD=replace-with-a-strong-password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-strong-password

# Backend (Spring Boot)
BACKEND_PORT=8080
# Generate a long random value, e.g. `openssl rand -base64 48`
JWT_SECRET=replace-with-a-long-random-secret

# LiveKit (self-hosted SFU)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=replace-with-livekit-key
LIVEKIT_API_SECRET=replace-with-livekit-secret
